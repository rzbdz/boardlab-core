{
  "name": "boardlab-core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The core of boardlab: board locks, the backend contract, boardd's API gateway, the CLI framework and the default page. Distributions add modules.",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "node scripts/check-architecture.mjs && node scripts/build.mjs",
    "check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.27.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
